# Example only — see docs/CONFIG.md
name: metal-mirage-vpn
runtime: go
description: WireGuard city-exit VM (cloud-init)
# Required:
#   pulumi config set vpn:sshPublicKey "$(cat ~/.ssh/id_ed25519.pub)"
# Recommended (SSH + node_exporter; WireGuard UDP remains open for peers):
#   pulumi config set vpn:adminCidr "$(curl -fsSL ifconfig.me)/32"
# Optional:
#   pulumi config set vpn:city us
#   pulumi config set vpn:location eastus
#   pulumi config set vpn:vmSize Standard_D2s_v4   # default B1s often SkuNotAvailable; ./scripts/pick-azure-vm-size.sh eastus 1
